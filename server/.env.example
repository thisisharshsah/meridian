# Local SQLite file. `mode=rwc` creates it on first run.
DATABASE_URL=sqlite://../data/suite.db?mode=rwc

# Signs access tokens. Generate one for anything but local dev:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

BIND_ADDR=127.0.0.1:7011
ACCESS_TTL_SECS=3600
REFRESH_TTL_SECS=2592000
CORS_ORIGINS=

# Which package this installation is: full, shop, pharmacy, hotel, services,
# trades. `suite-server editions` lists them and says what each one carries.
# Anything outside it is not registered at startup — no routes, no menu, no
# reports — and an unknown name refuses to boot rather than serving the lot.
EDITION=full

# Logging: try `suite_server=debug,sqlx=info` to see every query.
RUST_LOG=suite_server=info,tower_http=info,sqlx=warn
